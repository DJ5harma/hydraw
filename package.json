{
  "name": "hydraw",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tooling/dev.mjs",
    "build": "vp run -r build",
    "start": "node apps/server/dist/index.mjs",
    "check": "vp check && pnpm run typecheck && node tooling/check-boundaries.mjs",
    "typecheck": "tsc --noEmit && pnpm -r --if-present run typecheck",
    "test": "vp test --run",
    "test:e2e": "playwright test",
    "test:docker": "node tooling/smoke-container.mjs",
    "ready": "pnpm run check && pnpm run test && pnpm run build && pnpm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "oxc-parser": "catalog:",
    "typescript": "7.0.2",
    "vite-plus": "1.3.0"
  },
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "packageManager": "pnpm@12.14.0"
}
